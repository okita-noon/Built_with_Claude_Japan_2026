{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "筆カード",
  "type": "object",
  "required": ["chiban", "toki_chimoku", "genkyo", "meigi", "shutoku"],
  "properties": {
    "chiban": { "type": "string", "description": "所在と地番" },
    "yobina": { "type": "string", "description": "母の呼び名（例：沢の上の田んぼ）" },
    "toki_chimoku": { "type": "string", "description": "登記の地目" },
    "genkyo": { "type": "string", "description": "現況" },
    "menseki_m2": { "type": ["number", "null"] },
    "meigi": { "type": "string", "description": "登記名義人" },
    "shutoku": { "type": "string", "description": "母の取得原因（相続／売買／未確定など）" },
    "hisouzokunin_shibou": { "type": ["string", "null"], "format": "date" },
    "building": { "type": "string" },
    "structures": { "type": "array", "items": { "type": "string" } },
    "boundary": { "type": "string" },
    "others_use": { "type": "string" },
    "rights": { "type": "string" },
    "cliff": { "type": "string" },
    "underground": { "type": "string" },
    "forest_care": { "type": "string" },
    "disaster": { "type": "string" },
    "neighbor_trouble": { "type": "string" },
    "recurring_charges": { "type": "string" },
    "haha_shogen": { "type": "string", "description": "母の言葉そのまま" },
    "evidence": {
      "type": "array",
      "description": "各項目の出どころ。値は『不明』を正式に持てる",
      "items": {
        "type": "object",
        "required": ["field", "source"],
        "properties": {
          "field": { "type": "string" },
          "source": { "enum": ["母の証言", "課税明細書", "登記", "公開地図", "航空写真", "家族", "不明"] },
          "recorded_at": { "type": "string", "format": "date-time" },
          "audio_ref": { "type": "string" }
        }
      }
    }
  }
}
