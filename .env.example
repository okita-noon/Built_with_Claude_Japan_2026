# Claude on Vertex AI（Google Cloud 認証を使う。ローカルは `gcloud auth application-default login` 済み前提）
ANTHROPIC_VERTEX_PROJECT_ID=
CLOUD_ML_REGION=us-east5
# サービスアカウントJSONを使う場合のみ（ローカルの ADC で足りれば未設定で可）
# GOOGLE_APPLICATION_CREDENTIALS=
# Vertex 上の Claude モデルID（コンソールで現行版を確認。例: claude-sonnet-4-5@20250929）
CLAUDE_MODEL=

# Gemini Live API（Google AI Studio。サーバー側でのみ使用し、ブラウザには ephemeral token を渡す）
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live

# Jev（TypeSafe AI）
JEV_API_KEY=
JEV_MODEL=jev-latest

# 保存先（ローカルは未設定なら SQLite: ./data/local.db）
DATABASE_URL=

# 任意：不動産情報ライブラリ
REINFOLIB_API_KEY=
