# Claude（Anthropic 直 API）
ANTHROPIC_API_KEY=
# 使用モデルID（例: claude-opus-4-7, claude-sonnet-4-6）
CLAUDE_MODEL=claude-sonnet-4-6

# Gemini Live API（Google AI Studio。サーバー側でのみ使用し、ブラウザには ephemeral token を渡す）
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live

# Jev（TypeSafe AI）
JEV_API_KEY=
JEV_MODEL=jev-latest

# 保存先（ローカルは未設定なら SQLite: ./data/local.db）
DATABASE_URL=

# 任意：不動産情報ライブラリ
REINFOLIB_API_KEY=
