# Claude（Anthropic 直 API）。未設定ならルールベースのモックで動く
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Gemini Live API（Google AI Studio。サーバー側でのみ使用し、ブラウザには ephemeral token を渡す）
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# デモ動画のナレーション生成（scripts/video/tts.ts）だけで使う
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Jev（TypeSafe AI）。未設定ならモックのタグ付け
JEV_API_KEY=
JEV_MODEL=jev-latest
